# Docker deployment configuration (copy to .env)
# Docker Hub image published by this repository; see the README for deployment instructions.
ARTEX_IMAGE=ruoji6/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (set either or both; may also be left blank and configured in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
