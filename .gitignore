# claude code local state
.claude/

# Single-binary artifacts with the frontend embedded
/artex
# Intermediate artifacts left next to the executable by one-click updates (staged file / backup / failed version / update marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never committed)
/jwt.key

# Local environment generated by Docker deployment (contains passwords/secrets; do not commit)
.env

# Event logs generated by scheduler runs/simulations (test artifacts; do not commit)
*-events.csv

# Benchmark-related local artifacts (do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
